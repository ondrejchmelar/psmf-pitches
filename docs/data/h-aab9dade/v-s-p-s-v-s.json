ý fotbal. V prvním poločase měli víc šancí domácí. Po přestávce přišel Břewnowu hráč a převzal otěže hry. Domácí ovšem nesložili zbraně a v posledních deseti minutách otočili skóre na svou stranu. Poslední slovo ale měl Haleš a svým třetím gólem vyrovnal."},{"d":"2024-09-23","l":"podzim 2024","v":"CESMI","h":false,"s":"1:4","hf":"1:2","r":"W","ref":"Jakub Plechšmíd","w":"Domácí měli skvělý vstup do utkání, ale pak dostali dva slepené góly a do tempa už se nedostali."},{"d":"2023-10-23","l":"podzim 2023","v":"CESMI","h":false,"s":"1:2","hf":"0:1","r":"W","ref":"Aleš Řeřicha","w":"Mládí předčilo zkušenost, byť by remíza byla asi spravedlivější."}],"Klucy PFS":[{"d":"2025-09-01","l":"podzim 2025","v":"MIKU4","h":true,"s":"5:1","hf":"2:0","r":"W","ref":"Tomáš Andrle, Jan Novák","w":"Výrazná herní převaha domácího týmu se promítla do narůstajícího skóre, jenž se zastavilo na konečných 5:1."}],"Manchlastr FC":[{"d":"2026-03-23","l":"jaro 2026","v":"MIKU2","h":true,"s":"3:2","hf":"3:1","r":"W","ref":"Pavel Potměšil","w":"Dramatický a též hodně vyhecovaný zápas. Hosté byli sice zejména v 1.pol střelecky aktivnější. Tři poměrně jednoduché zásahy soupeře je ale srazili a domácí se už o dobrý výsledek připravit nenechali."},{"d":"2020-12-07","l":"podzim 2020","v":"P2","h":false,"s":"1:0","hf":"1:0","r":"L","ref":"","w":""},{"d":"2020-06-15","l":"jaro 2020","v":"P3","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""}],"Františci":[{"d":"2024-05-06","l":"jaro 2024","v":"MIKU1","h":false,"s":"2:4","hf":"2:1","r":"W","ref":"Michal Boháč","w":"Vyrovnané utkání, hosté ale byli lepší v zakončení."}],"OOO FC":[{"d":"2024-04-29","l":"jaro 2024","v":"MIKU1","h":true,"s":"4:1","hf":"3:0","r":"W","ref":"Pavel Beneš","w":"Svižné utkání se zaslouženou výhrou domácích."}]},"cr":[["j2007","5-h",8,12,"11","4","1","6","22:29","9"],["p2007","5-d",10,12,"11","3","1","7","32:36","7"],["j2008","6-j",7,12,"11","5","0","6","35:35","10"],["p2008","6-j",3,12,"11","8","1","2","49:30","17"],["j2009","5-