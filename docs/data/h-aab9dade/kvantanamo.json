{"t":"Kvantanámo","o":{"Blázinec 2":[{"d":"2025-09-01","l":"podzim 2025","v":"PLAM","h":true,"s":"3:1","hf":"1:1","r":"W","ref":"Jiří Smetana","w":"Kvalitní utkání rozhodlo proměňování šancí."},{"d":"2025-06-02","l":"jaro 2025","v":"PLAM","h":true,"s":"3:3","hf":"2:2","r":"D","ref":"Miroslav Kotek","w":"Rychlé utkání z obou stran. Hosté měli mírnou převahu, ale v koncovce se jim tolik nedařilo, zasloužená remíza."},{"d":"2024-05-13","l":"jaro 2024","v":"P2","h":false,"s":"7:4","hf":"3:2","r":"L","ref":"","w":"Vyhráli domácí."},{"d":"2023-09-18","l":"podzim 2023","v":"P3","h":false,"s":"4:2","hf":"0:1","r":"L","ref":"Jan Dont","w":"Ač domácí prohrávali 0:2, dokázali zápas otočit a zvítězit."}],"Gepard AFC":[{"d":"2025-09-08","l":"podzim 2025","v":"MIKU3","h":false,"s":"3:4","hf":"2:2","r":"W","ref":"Pavel Potměšil","w":"Hrál se pěkný, kombinační fotbal. Domácí paradoxně prohráli."},{"d":"2025-03-24","l":"jaro 2025","v":"MIKU2","h":false,"s":"1:2","hf":"0:1","r":"W","ref":"","w":"Hostům vychytal výhru brankář."},{"d":"2023-06-12","l":"jaro 2023","v":"MIKU1","h":false,"s":"6:5","hf":"2:3","r":"L","ref":"Martin Průša","w":"Nervózní utkání s mnoha fauly na obou stranách. Přesto se občas hrál i pohledný fotbal."},{"d":"2022-10-10","l":"podzim 2022","v":"STER2","h":false,"s":"5:0","hf":"1:0","r":"L","ref":"","w":"Utkání bez závad. Výrazná herní převaha domácích."},{"d":"2020-06-01","l":"jaro 2020","v":"PLAM","h":true,"s":"0:0","hf":"","r":"D","ref":"","w":""}],"Ujde to 1980 SK":[{"d":"2025-11-03","l":"podzim 2025","v":"PLAM","h":false,"s":"5:2","hf":"4:2","r":"L","ref":"Lukáš Tomanec, Vojtěch Zimmel","w":"Férový zápas nakonec vyhráli domácí."},{"d":"2019-04-08","l":"jaro 2019","v":"ZAK","h":false,"s":"4:2","hf":"1:1","r":"L","ref":"Janča","w":"První půle byla vyrovnaná, se spoustou hezkých akcí, ale i promarněných šancí. Po přestávce byli domácí lepší a rychle odskočili na dvoubrankový rozdíl. Kvantanámo sice ještě snížilo, ale při honbě za vyrovnáním v závěru smolně inkasovalo."}],"Smutný potapěči":[{"d":"2025-11-24","l":"podzim 2025","v":"PLAM","h":true,"s":"3:5","hf":"3:1","r":"L","ref":"David Průša","w":"Dramatické utkání rozdílných poločasů. Potápěči otočili výsledek riskantní hrou s prvky power-play. Dva góly vstřelil brankář Vrzal – první skvělou ranou do vinglu téměř od půlící čáry a druhým pečetil do prázdné brány přes celé hřiště."},{"d":"2024-10-21","l":"podzim 2024","v":"TEMPO","h":false,"s":"10:9","hf":"3:4","r":"L","ref":"Zdeněk Petr","w":"Velmi útočný zápas s vítězstvím domácích."}],"Deportivo bez Coruna A":[{"d":"2025-03-31","l":"jaro 2025","v":"PLAM","h":true,"s":"4:8","hf":"2:3","r":"L","ref":"Petr Mládek","w":"V prvním poločase se hosté dvakrát ujali vedení, na což Kvantanámo ještě dokázalo reagovat. Na další góly již nenašlo dostatečnou odpověď, Deportivo útoky domácích ubránilo a po zásluze zvítězilo."},{"d":"2024-11-04","l":"podzim 2024","v":"PLAM","h":true,"s":"1:7","hf":"0:3","r":"L","ref":"Petr Sedlák","w":"Bojovný, rychlý zápas. Zvítězilo kombinačně lepší mužstvo."},{"d":"2023-04-03","l":"jaro 2023","v":"PLAM","h":true,"s":"1:6","hf":"0:3","r":"L","ref":"","w":"Aktivnější hosté dominovali v celém utkání a díky lepší kombinaci a tahu na branku zvítězili."},{"d":"2022-12-12","l":"podzim 2022","v":"PLAM","h":false,"s":"7:4","hf":"4:2","r":"L","ref":"Jaroslav Havran","w":"Dynamické utkání. Hosté dokázali v druhém poločase vyrovnat, ale závěr vyšel lépe Deportivu."},{"d":"2021-11-29","l":"podzim 2021","v":"DEKAN","h":false,"s":"14:5","hf":"4:3","r":"L","ref":"","w":"Utkání bohaté na branky, oba týmy hrály ve velké pohodě."},{"d":"2019-06-10","l":"jaro 2019","v":"HOSTI","h":false,"s":"2:2","hf":"1:2","r":"D","ref":"","w":"Místy až moc emotivní utkání, ve kterém šlo o hodně. Po fotbalové stránce parádní výkon od obou týmů."},{"d":"2014-11-03","l":"podzim 2014","v":"STER3","h":true,"s":"7:3","hf":"0:3","r":"W","ref":"Roman Volák, Petr Linx","w":"Ze začátku po třech rychlých golech to vypadalo na jasnou výhru Deporti