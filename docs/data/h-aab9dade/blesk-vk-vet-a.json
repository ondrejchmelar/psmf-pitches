{"t":"Blesk VK VET A","o":{"Hertha ZMZ VET":[{"d":"2026-05-13","l":"jaro 2026","v":"STER3","h":false,"s":"1:5","hf":"0:2","r":"W","ref":"Stanislav Holman","w":"Poklidné kombinační utkání, vyhráli hosté."},{"d":"2025-04-16","l":"jaro 2025","v":"STER3","h":true,"s":"4:5","hf":"2:2","r":"L","ref":"Jiří Bouše","w":"Vyrovnané utkání, ve kterém dlouho za delší konec tahali domácí. Hostům se podařil obrat a odskočení o dva góly. Domácí se ale nevzdali a bojovali až do konce."},{"d":"2024-11-14","l":"podzim 2024","v":"STER1","h":true,"s":"2:5","hf":"1:1","r":"L","ref":"Adam Rulf","w":"Jednoznačné vítězství hostů."},{"d":"2024-05-02","l":"jaro 2024","v":"STER1","h":false,"s":"4:5","hf":"0:3","r":"W","ref":"Karel Janďourek","w":"V rychlém a férově vedeném utkání zvítězili hosté."},{"d":"2020-04-23","l":"jaro 2020","v":"HOSTI","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2017-05-25","l":"jaro 2017","v":"HOSTI","h":true,"s":"3:2","hf":"0:2","r":"W","ref":"","w":"Hosté vedli po půli o dvě branky a zdálo se, že si dokráčejí pro vítězství. Ve druhé půli však domácí převedli krásný obrat, který zakončili vítěznou brankou v úplném závěru utkání."}],"Plameňáci 1.FC VET":[{"d":"2025-09-17","l":"podzim 2025","v":"STER3","h":false,"s":"1:2","hf":"1:2","r":"W","ref":"Martin Paleček","w":"Remíza by byla spravedlivější."},{"d":"2019-10-16","l":"podzim 2019","v":"LITVI","h":true,"s":"4:0","hf":"1:0","r":"W","ref":"","w":"Oba celky předváděly hezkou kombinační hru. Vyhráli domácí."}],"Gladiators Beroun VET":[{"d":"2024-06-21","l":"jaro 2024","v":"CESMI","h":true,"s":"3:6","hf":"0:3","r":"L","ref":"Jan Kehár","w":"Jednoznačné vítězství hostů. Hezké utkání."}],"Javorák":[{"d":"2015-10-19","l":"podzim 2015","v":"ZAK","h":false,"s":"2:0","hf":"1:0","r":"L","ref":"Boubín, Bubník","w":"Blesk nedokázala proměnit své šance, a tak Javorák tvrdě trestal."},{"d":"2015-06-01","l":"jaro 2015","v":"ZAK","h":false,"s":"1:3","hf":"1:1","r":"W","ref":"","w":"Pohledné utkání hrané v duchu fair play. Zasloužená výhra hostů."}],"Čechie 12°":[{"d":"2024-09-04","l":"podzim 2024","v":"SLIVE","h":false,"s":"2:3","hf":"0:3","r":"W","ref":"Petr Havel","w":"Hráčům Blesku se povedly tři rychlé útoky a svůj náskok si uhájili až do závěru, i když Čechie finišovala a šance na zvrat měla. Slušně hrané, pohledné utkání."},{"d":"2020-03-25","l":"jaro 2020","v":"HRAB2","h":true,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2014-09-11","l":"podzim 2014","v":"SCBEC","h":true,"s":"4:2","hf":"0:1","r":"W","ref":"Stanislav Bednář, Pavel Kučera","w":"Domácí byli lepším týmem a zaslouženě vyhráli."},{"d":"2013-09-18","l":"podzim 2013","v":"MIKU4","h":false,"s":"2:2","hf":"0:0","r":"D","ref":"","w":"Domácí si nechali vzít vítězství v samém závěru."},{"d":"2012-06-27","l":"jaro 2012","v":"P3","h":false,"s":"1:3","hf":"0:2","r":"W","ref":"","w":"Utkání mohlo skončit vyšším brankovým rozdílem."}],"Deko VET":[{"d":"2026-03-25","l":"jaro 2026","v":"TEMPO","h":true,"s":"4:2","hf":"4:1","r":"W","ref":"Filip Černý","w":"Hosté čekali na posily, ale ty stihly jen dvacet minut a jeden gól."},{"d":"2025-11-05","l":"podzim 2025","v":"MIKU3","h":false,"s":"1:3","hf":"0:2","r":"W","ref":"Martin Hošek","w":"Deku se herně nedařilo, chyby ve středu pole Blesk bleskově trestal, a to i gólem do prázdné."},{"d":"2025-05-28","l":"jaro 2025","v":"BRAN1","h":true,"s":"1:1","hf":"1:0","r":"D","ref":"Petr Sedlák","w":"První poločas byli lepší domácí, druhý hosté. Zasloužená plichta."},{"d":"2024-10-09","l":"podzim 2024","v":"PRKOP","h":false,"s":"3:3","hf":"1:3","r":"D","ref":"Tomáš Nykl","w":"Deko bylo lepší na míči, ale dvě chyby v rozehrávce znamenaly dva góly v jejich síti. Po snížení hned přišla další chyba. Druhá půle už se hrála jen na bránu Blesku, vyrovnání se zrodilo dvě minuty před koncem, kdy si hosté srazili do brány dlouhý aut."},{"d":"2024-05-15","l":"jaro 2024","v":"HRAB1","h":true,"s":"4:2","hf":"3:1","r":"W","ref":"Tomáš Voldán","w":"Domácí působili lepším dojmem a zaslouženě zvítězili."},{"d":"2014-09-18","l":"podzim 2014","v":"MIKU3","h":false,"s":"3:5","hf":"1:2","r":"W","ref":"Dufek","w":"Domácí byli po celý zápas bez střídání, což asi rozhodlo. Pohledné utkání plné hezkých akcí z obou stran."}],"Inter Ohradní VET":[{"d":"2026-04-29","l":"jaro 2026","v":"MIKU4","h":true,"s":"3:8","hf":"1:4","r":"L","ref":"Jaroslav Havran","w":"Hosté byli lepším týmem a zaslouženě vyhráli díky střelci Dvořákovi."}],"Kings of Kent":[{"d":"2024-05-24","l":"jaro 2024","v":"BECH","h":false,"s":"8:6","hf":"6:4","r":"L","ref":"Adam Rulf","w":"Pohledné utkání, ve kterém šance střídala šanci. Vyhrál šťastnější tým."}],"Legends a Veterans":[{"d":"2026-04-22","l":"jaro 2026","v":"MOTO1","h":false,"s":"3:4","hf":"2:3","r":"W","ref":"Pavel Beneš","w":"Napínavé utkání až do poslední minuty."},{"d":"2025-09-03","l":"podzim 2025","v":"MOTO1","h":false,"s":"2:1","hf":"1:1","r":"L","ref":"Karel Janďourek","w":"Ve vyrovnaném zápase měli více šancí hosté, ale ztroskotali na skvělém gólmanovi Legend. Zápas tak rozhodla dalekonosná dělovka domácího Švarce."},{"d":"2025-03-26","l":"jaro 2025","v":"MOTO4","h":true,"s":"2:3","hf":"2:3","r":"L","ref":"Milan Husák, Zdeňka Kabeláčová","w":"Vyrovnané utkání, které rozhodl gól těsně před přestávkou."}]},"cr":[["j2007","2-a",7,12,"11","5","1","5","41:31","11"],["p2007","2-b",8,12,"11","4","1","6","32:39","9"],["j2008","2-a",7,12,"11","5","0","6","28:41","10"],["p2008","2-a",5,12,"11","6","1","4","48:29","13"],["j2009","2-b",5,12,"11","4","2","5","26:34","10"],["p2009","2-b",7,12,"11","4","2","5","42:47","10"],["j2010","2-b",12,12,"11","1","0","10","18:55","-4"],["p2010","3-a",3,12,"11","7","1","3","49:30","15"],["j2011","3-a",1,12,"11","8","0","3","58:22","16"],["p2011","2-b",11,12,"11","1","1","9","21:47","3"],["j2012","3-d",11,12,"11","5","1","5","39:34","5"],["p2012","4-c",5,12,"11","6","0","5","45:37","12"],["j2013","4-c",1,12,"11","11","0","0","69:14","22"],["p2013","3-c",4,12,"11","6","2","3","48:37","14"],["j2014","3-b",6,12,"11","5