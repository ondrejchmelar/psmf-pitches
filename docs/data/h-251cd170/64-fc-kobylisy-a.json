{"t":"64! FC Kobylisy A","o":{"Tuscarora 03":[{"d":"2016-09-15","l":"podzim 2016","v":"CESMI","h":true,"s":"4:1","hf":"2:1","r":"W","ref":"Tomáš Filous, Martin Šašek","w":"Slušně hrané utkání, rozhodlo proměňování šancí ve druhé půli. Tuscarora svoje tutovky zahodila a domácí tak berou oba body."},{"d":"2015-10-08","l":"podzim 2015","v":"MIKU4","h":false,"s":"2:1","hf":"0:0","r":"L","ref":"Michal Janoška, Tomáš Němec","w":"Vyrovnané utkání, kterému by slušela remíza, ale nejlepší hráč na hřišti byl proti. Kobylisy měly několik tutovek, ale nedaly, a proto prohrály. Hráno ve velkém tempu, technicky, tvrdě, ale korektně."}],"Hlavonožci na niti FC":[{"d":"2020-10-07","l":"podzim 2020","v":"ZAK","h":true,"s":"1:3","hf":"0:1","r":"L","ref":"Jambor","w":"Zpočátku velice klidné a vyrovnané utkání. Závěr patřil Hlavonožcům, domácí navíc zbytečně dohrávali v oslabení."},{"d":"2020-06-17","l":"jaro 2020","v":"ZAK","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2019-10-02","l":"podzim 2019","v":"ZAK","h":false,"s":"2:4","hf":"1:2","r":"W","ref":"Novotný","w":"V průměrném utkání měly od začátku více ze hry Kobylisy a po zásluze zvítězily."},{"d":"2017-11-29","l":"podzim 2017","v":"ZAK","h":true,"s":"2:10","hf":"1:4","r":"L","ref":"Vostatek","w":"Hosté byli celý zápas lepší. Přehráli soupeře ve všech ohledech a zaslouženě vyhráli."},{"d":"2017-05-03","l":"jaro 2017","v":"ZAK","h":true,"s":"1:3","hf":"1:2","r":"L","ref":"","w":"Hráči Kobylis si prohráli zápas vlastními chybami."}],"Reage boys":[{"d":"2023-10-18","l":"podzim 2023","v":"P1","h":false,"s":"0:2","hf":"0:1","r":"W","ref":"Kamil Kohout","w":"Ve vyrovnaném utkání vyhráli hosté."},{"d":"2020-03-25","l":"jaro 2020","v":"MOTO1","h":true,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2019-06-05","l":"jaro 2019","v":"ZABEH","h":false,"s":"1:5","hf":"1:3","r":"W","ref":"Michal Černoch, Libor Petřina","w":"Vedoucí gól vstřelili Reage boys, ale byl také jejich poslední. Kobylisy ještě do půle daly tři branky a po půli ještě dvě. Činil se zejména Bělohlávek, který dal hattrick."},{"d":"2017-05-10","l":"jaro 2017","v":"STER3","h":false,"s":"2:5","hf":"1:3","r":"W","ref":"Hošek","w":"Zasloužené vítězství fotbalovějšího týmu Kobylis."}],"Inter Ještě Jedno":[{"d":"2025-05-21","l":"jaro 2025","v":"P1","h":true,"s":"1:2","hf":"0:1","r":"L","ref":"Kamil Kohout","w":"Hosté byli aktivnější a měli více ze hry."}],"Executors United":[{"d":"2026-04-29","l":"jaro 2026","v":"DEKAN","h":true,"s":"9:1","hf":"3:1","r":"W","ref":"Milan Husák","w":"Kobylisy byly zejména ve druhém poločase výrazně lepším týmem a zaslouženě zvítězily vysokým rozdílem."},{"d":"2025-05-28","l":"jaro 2025","v":"ZABEH","h":false,"s":"0:3","hf":"0:0","r":"W","ref":"Tomáš Velík","w":"Zápas byl v prvním poločase absolutně vyrovnaný, ve druhém se projevila únava Executors a Kobylisy třikrát skórovaly."},{"d":"2020-09-09","l":"podzim 2020","v":"ZABEH","h":true,"s":"6:1","hf":"2:1","r":"W","ref":"Dufek","w":"Vyrovnaný první poločas. Utkání se zlomilo ve druhé půli a domácí zaslouženě vyhráli."},{"d":"2020-04-01","l":"jaro 2020","v":"ZABEH","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2019-05-22","l":"jaro 2019","v":"ZABEH","h":false,"s":"1:4","hf":"0:2","r":"W","ref":"","w":"Executors byli důrazní, ale Kobylisy fotbalovější, a hlavně proto zvítězily."},{"d":"2018-09-12","l":"podzim 2018","v":"ZABEH","h":true,"s":"3:3","hf":"0:2","r":"D","ref":"Beneš","w":"Vyrovnané utkání v obou poločasech. Zasloužená remíza pro oba celky. V první půli lepší Executors, v druhé Kobylisy."},{"d":"2017-04-12","l":"jaro 2017","v":"ZABEH","h":true,"s":"6:2","hf":"2:1","r":"W","ref":"Libor Kosman, Jan Kilián","w":"Pěkné a v prvním poločase vyrovnané utkání. V druhém poločase se už prosazovali hlavně domácí."}],"Sváteční mančaft":[{"d":"2025-04-23","l":"jaro 2025","v":"STER3","h":false,"s":"1:3","hf":"1:1","r":"W","ref":"Jakub Plechšmíd, Václav Kovařík","w":"Pěkné utkání. Kobylisy o své výhře rozhodly ve druhém poločase."}]},"cr":[[