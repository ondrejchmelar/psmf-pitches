{"t":"PFC Kodymka B","o":{"Yakuza":[{"d":"2025-05-12","l":"jaro 2025","v":"SANC1","h":true,"s":"4:3","hf":"1:2","r":"W","ref":"Omar Charhouli","w":"Hosté dlouhou dobu drželi jednogólový náskok, ale v zavěrečné čtvrthodině domácí zabrali a zápas zaslouženě otočili."},{"d":"2017-10-16","l":"podzim 2017","v":"HRAB1","h":false,"s":"1:4","hf":"1:2","r":"W","ref":"David Linhart, Jan Kutman","w":"Přestože si Yakuza v závěru vytvořila tlak, na perfektní hosty to nestačilo."}],"Kerata Chíjos":[{"d":"2025-11-24","l":"podzim 2025","v":"HOSTI","h":true,"s":"2:5","hf":"1:2","r":"L","ref":"Sergey Greshnyakov","w":"Hosté byli o něco fotbalovějším týmem a zaslouženě vyhráli."},{"d":"2015-03-23","l":"jaro 2015","v":"HRAB1","h":false,"s":"4:0","hf":"0:0","r":"L","ref":"Symon, Sambor","w":"V první půli byl zápas velmi vyrovnaný. Ale jen co začal druhý poločas, domácí se vzchopili a dokázali soupeře rozhodit třemi brankami. Vstřelená vlastní branka pak už jen navýšila gólový rozdíl a potvrdila vítězství domácího týmu."},{"d":"2014-06-16","l":"jaro 2014","v":"MIKU3","h":true,"s":"2:5","hf":"1:4","r":"L","ref":"Šmahal, Rajniš","w":"V utkání dominovali hosté, byli po celou dobu lepším týmem a zaslouženě zvítězili."},{"d":"2012-04-16","l":"jaro 2012","v":"HRAB1","h":false,"s":"3:3","hf":"1:0","r":"D","ref":"David Pracner, Martin Procházka","w":"Tento zápas byl zajímavý a velmi vyrovnaný. Vše bylo bez problému."}],"Senioři Praha A":[{"d":"2025-09-01","l":"podzim 2025","v":"HRAB1","h":false,"s":"2:3","hf":"2:2","r":"W","ref":"","w":"Vyrovnané utkání rozhodl gól v poslední minutě."},{"d":"2025-05-26","l":"jaro 2025","v":"HRAB1","h":false,"s":"1:3","hf":"1:1","r":"W","ref":"David Kocman","w":"Vyrovnané utkání nakonec lépe zvládli hosté."},{"d":"2023-10-30","l":"podzim 2023","v":"HRAB1","h":true,"s":"3:1","hf":"1:1","r":"W","ref":"Tomáš Andrle","w":"Vyrovnaný zápas rozhodla v závěru chyba hostů."},{"d":"2022-05-09","l":"jaro 2022","v":"HRAB2","h":true,"s":"5:0","hf":"0:0","r":"W","ref":"Blahout","w":"Vynikající zápas od obou mužstev."},{"d":"2021-11-08","l":"podzim 2021","v":"HRAB1","h":false,"s":"1:0","hf":"0:0","r":"L","ref":"Andrle","w":"Vyrovnané utkání rozhodl jeden gól v závěru."},{"d":"2021-06-07","l":"podzim 2020","v":"SANC1","h":true,"s":"3:4","hf":"1:1","r":"L","ref":"Petr Mácha, Pavel Procházka","w":"Poklidné utkání, takřka bez faulů. Vyhráli hosté."},{"d":"2020-04-06","l":"jaro 2020","v":"HRAB1","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2019-12-02","l":"podzim 2019","v":"MIKU4","h":false,"s":"0:4","hf":"0:3","r":"W","ref":"","w":"Zápas proběhl bez komplikací."},{"d":"2018-10-08","l":"podzim 2018","v":"HRAB2","h":true,"s":"1:4","hf":"0:1","r":"L","ref":"Josef Dufek, Petr Buchta","w":"Utkání hrané v poklidné atmosféře bylo ovlivněno faktem, že Kodymka B hrála celé utkání o jednoho hráče v poli méně. Přesto byl projev hráčů velmi fotbalový. Vyhráli Senioři."},{"d":"2018-04-16","l":"jaro 2018","v":"HRAB3","h":false,"s":"0:0","hf":"0:0","r":"D","ref":"","w":"Oba týmy šetřily míč a zakončení akcí nevedlo k vítězství ani jedné strany. Remíza je maximum pro oba celky."},{"d":"2017-11-13","l":"podzim 2017","v":"HRAB2","h":false,"s":"4:2","hf":"1:0","r":"L","ref":"Vuhovič","w":"Náskok domácích byl 15 minut před koncem smazán, nicméně potom Senioři opět zabrali a zaslouženě vyhráli."},{"d":"2017-03-20","l":"jaro 2017","v":"HRAB3","h":true,"s":"1:2","hf":"0:0","r":"L","ref":"","w":"Utkání průměrné úrovně, ve kterém dokázal hostující tým zvítězit."},{"d":"2015-11-09","l":"podzim 2015","v":"HRAB3","h":true,"s":"3:3","hf":"0:2","r":"D","ref":"Norman David, Michal Kubeš","w":"Mírně nervózní utkání vyrovnaného průběhu skončilo spravedlivou remízou."},{"d":"2014-09-08","l":"podzim 2014","v":"HRAB2","h":false,"s":"3:3","hf":"1:2","r":"D","ref":"","w":"Zápas byl poměrně vyrovnaný. Šancí bylo na obou stranách stejně. Zápas skončil spravedlivým výsledkem."},{"d":"2013-10-07","l":"podzim 2013","v":"HRAB1","h":true,"s":"3:1","hf":"2:0","r":"W","ref":