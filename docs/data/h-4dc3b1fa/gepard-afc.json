{"t":"Gepard AFC","o":{"Ujde to 1980 SK":[{"d":"2025-09-01","l":"podzim 2025","v":"MIKU3","h":false,"s":"5:2","hf":"4:0","r":"L","ref":"Tomáš Chlum","w":"Svižný zápas nahoru dolů se šancemi na obou stranách."},{"d":"2019-09-09","l":"podzim 2019","v":"ZAK","h":false,"s":"2:3","hf":"1:2","r":"W","ref":"Jambor","w":"Domácí hráli celý první poločas ve čtyřech, přesto drželi naději na dobrý výsledek. Dokázali po přestávce dokonce vyrovnat, nakonec ale slavil těsnou výhru Gepard."}],"Kvantanámo":[{"d":"2025-09-08","l":"podzim 2025","v":"MIKU3","h":true,"s":"3:4","hf":"2:2","r":"L","ref":"Pavel Potměšil","w":"Hrál se pěkný, kombinační fotbal. Domácí paradoxně prohráli."},{"d":"2025-03-24","l":"jaro 2025","v":"MIKU2","h":true,"s":"1:2","hf":"0:1","r":"L","ref":"","w":"Hostům vychytal výhru brankář."},{"d":"2023-06-12","l":"jaro 2023","v":"MIKU1","h":true,"s":"6:5","hf":"2:3","r":"W","ref":"Martin Průša","w":"Nervózní utkání s mnoha fauly na obou stranách. Přesto se občas hrál i pohledný fotbal."},{"d":"2022-10-10","l":"podzim 2022","v":"STER2","h":true,"s":"5:0","hf":"1:0","r":"W","ref":"","w":"Utkání bez závad. Výrazná herní převaha domácích."},{"d":"2020-06-01","l":"jaro 2020","v":"PLAM","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""}],"Deko":[{"d":"2010-11-08","l":"podzim 2010","v":"P2","h":false,"s":"4:1","hf":"4:0","r":"L","ref":"","w":"Pokud by se hrál zápas až od 11. minuty napsal bych spravedlivá remíza, ovšem tři branky, které padly během deseti minut rozhodly."},{"d":"2009-04-27","l":"jaro 2009","v":"P1","h":false,"s":"1:2","hf":"0:0","r":"W","ref":"","w":"Utkání bez problémů, hosté po dvou hezkých gólech zaslouženě vyhráli."}],"Smutný potapěči":[{"d":"2025-09-22","l":"podzim 2025","v":"TEMPO","h":false,"s":"4:6","hf":"1:1","r":"W","ref":"Filip Černý","w":"Pohledné utkání. Domácí se snažili vyrovnat do poslední chvíle."},{"d":"2025-04-14","l":"jaro 2025","v":"TEMPO","h":false,"s":"9:4","hf":"4:3","r":"L","ref":"Petr Sedlák","w":"Arogantní hosté dostali za vyu