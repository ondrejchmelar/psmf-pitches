{"t":"Banana Chiquíta","o":{"Masokombinát":[{"d":"2022-10-04","l":"podzim 2022","v":"ARIT","h":true,"s":"6:1","hf":"2:0","r":"W","ref":"Milan Husák","w":"První poločas byl lepší tým Banánů, po dvou chybách soupeře se ujal vedení. Ve druhém poločase po další chybě padl třetí gól do sítě Masokombinátu a domácí svůj náskok dál navyšovali. Celkově byl tým Banánů lepší a zaslouženě zvítězil."}],"Red Leads":[{"d":"2019-09-17","l":"podzim 2019","v":"STER1","h":true,"s":"2:2","hf":"1:1","r":"D","ref":"Jedlička","w":"Zápas fotbalový, technický. První poločas vyrovnaný, druhý lepší hosté, kteří soupeře přehrávali a hnali se za vyrovnáním, což se jim v závěru zaslouženě povedlo."}],"Emergency":[{"d":"2023-04-17","l":"jaro 2023","v":"DEKAN","h":false,"s":"4:6","hf":"0:3","r":"W","ref":"Blahout","w":"Hráno za mokra na kluzkém terénu, slušné utkání."}],"England United FC":[{"d":"2025-10-07","l":"podzim 2025","v":"MIKU2","h":true,"s":"3:2","hf":"1:0","r":"W","ref":"Adam John","w":"Napínavé utkání, domácí rozhodli v závěru."},{"d":"2025-05-06","l":"jaro 2025","v":"MIKU2","h":false,"s":"0:7","hf":"0:3","r":"W","ref":"Lukáš Krajči","w":"Jednoznačná záležitost pro hosty."}],"Merck stars":[{"d":"2024-06-24","l":"jaro 2024","v":"KORAB","h":false,"s":"7:2","hf":"4:2","r":"L","ref":"Tomáš Chlum","w":"Domácí byli přesnější v zakončení."},{"d":"2021-09-14","l":"podzim 2021","v":"SANC1","h":false,"s":"4:2","hf":"3:0","r":"L","ref":"Hošek","w":"Slušně hrané utkání, ve kterém naděje hostů na závěrečný tlak zhatila červená pro brankáře za ruku mimo pokutové území."},{"d":"2013-05-21","l":"jaro 2013","v":"MIKU3","h":true,"s":"2:0","hf":"0:0","r":"W","ref":"Filip Mazánek, Filip Kotchera","w":"Vyrovnaný zápas, který díky lepší koncovce ovládli domácí."},{"d":"2012-06-25","l":"jaro 2012","v":"HRAB2","h":false,"s":"1:6","hf":"1:3","r":"W","ref":"","w":"Od začátku jasně lepší a běhavější hosté nedali soupeři mnoho šancí. Ke konci zaslouženě navýšili skóre."}],"Šílení kačeři":[{"d":"2025-09-17","l":"p