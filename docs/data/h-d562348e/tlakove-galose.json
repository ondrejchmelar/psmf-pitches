{"t":"Tlakové galoše","o":{"V.S.P.S.V.S.":[{"d":"2026-05-11","l":"jaro 2026","v":"MIKU4","h":false,"s":"0:4","hf":"0:3","r":"W","ref":"","w":"Férový zápas rozhodl skvělý start hostů."},{"d":"2021-06-07","l":"podzim 2020","v":"MIKU2","h":false,"s":"7:3","hf":"3:0","r":"L","ref":"Tomáš Voldán","w":"Bojovné utkání. Vyhráli domácí."},{"d":"2020-05-18","l":"jaro 2020","v":"MIKU2","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2017-11-20","l":"podzim 2017","v":"MIKU1","h":false,"s":"2:5","hf":"2:2","r":"W","ref":"","w":"Pěkné vyrovnané utkání, ve kterém se hrálo hodně útočně. Hosté byli přesnější v koncovce a díky tomu získali dva důležité body za vítězství."},{"d":"2016-10-31","l":"podzim 2016","v":"MIKU2","h":false,"s":"2:0","hf":"1:0","r":"L","ref":"Košťál","w":"Krásný zápas. Domácí měli více štěstí při zakončování, zato hosté, i kdyby hráli dvě hodiny, gól nedají."},{"d":"2016-06-20","l":"jaro 2016","v":"MIKU1","h":true,"s":"2:3","hf":"1:3","r":"L","ref":"Kohout","w":"Hosté dobře začali, ale nakonec se strachovali o body."},{"d":"2015-11-02","l":"podzim 2015","v":"MIKU2","h":false,"s":"1:3","hf":"1:3","r":"W","ref":"Plucar","w":"Pohlední utkání z obou stran vyhrály Tlakové galoše díky lepšímu proměňování šancí."},{"d":"2010-06-07","l":"jaro 2010","v":"MIKU2","h":false,"s":"1:3","hf":"1:1","r":"W","ref":"","w":"Hosté měli celý zápas více ze hry, ale co se šancí týká, tak to bylo fifty-fifty. Nakonec se štěstí usmálo na Galoše."}],"Břewnow boys KMK":[{"d":"2012-09-03","l":"podzim 2012","v":"HRAB1","h":false,"s":"3:2","hf":"1:1","r":"L","ref":"Tomáš Kriebel","w":"Kvalitní utkání, v prvním poločase měli více ze hry hráči Břewnowa, do přestávky ale hosté srovnali skóre. V závěru domácí vstřelili dva slepené góly, Galoše sice vzápětí snížily, ale ne vyrovnání už neměly dostatek času."},{"d":"2012-04-16","l":"jaro 2012","v":"HRAB2","h":false,"s":"4:2","hf":"2:0","r":"L","ref":"Karel Janďourek, Richard Klípa","w":"Pro utkání byla charakteristická čtvrtá branka Břewnova: po banálním faulu na půlce se Galoše tak vehementně věnovali protestům směrem k rozhodčímu, že nezachytili rychlé rozehrání soupeře. Zápas byl plný hezkých akcí, ale také faulů, oplácení, protestů a stálého vytváření tlaku na sudího od obou laviček."}],"Klucy PFS":[{"d":"2022-10-17","l":"podzim 2022","v":"HRAB1","h":false,"s":"6:2","hf":"3:1","r":"L","ref":"Tomáš Voldán","w":"Solidní utkání se zaslouženou výhrou domácích."},{"d":"2022-05-30","l":"jaro 2022","v":"HRAB1","h":false,"s":"5:1","hf":"0:1","r":"L","ref":"Valentyn Kovalchuk","w":"Domácí byli efektivnější."}],"Manchlastr FC":[{"d":"2026-06-01","l":"jaro 2026","v":"HRAB1","h":true,"s":"5:1","hf":"4:0","r":"W","ref":"Milan Růžička","w":"Zápas dobré úrovně pro sebe rozhodli důraznější hráči Tlakových galošů."},{"d":"2024-04-29","l":"jaro 2024","v":"P1","h":false,"s":"3:1","hf":"1:1","r":"L","ref":"Martin Hošek","w":"Pohledné utkání zvládli lépe domácí."},{"d":"2020-08-31","l":"podzim 2020","v":"SANC1","h":false,"s":"4:1","hf":"2:0","r":"L","ref":"","w":"Domácí tým byl více hladový po vítězství, ale dlouho mu trvalo, než svou převahu ukázal v gólech. Hostům se nedá upřít snaha, ale víc jak na gól to nestačilo."},{"d":"2020-04-20","l":"jaro 2020","v":"HRAB1","h":true,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2019-04-01","l":"jaro 2019","v":"HRAB3","h":false,"s":"8:5","hf":"5:3","r":"L","ref":"Jan Vrba, Marek Valter","w":"Do 26. minuty poměrně vyrovnané utkání, poté už měli na hřišti převahu domácí. Pěkné utkání hrané v rychlém tempu s vysokým počtem vstřelených gólů na obou stranách."}],"Františci":[{"d":"2025-09-15","l":"podzim 2025","v":"STER1","h":false,"s":"1:6","hf":"1:3","r":"W","ref":"","w":"Sebevědomé vítězství a hra od hostů."},{"d":"2023-04-24","l":"jaro 2023","v":"HRAB2","h":false,"s":"5:3","hf":"3:0","r":"L","ref":"Tomáš Procházka, Josef Klail","w":"Domácí byli lepším týmem, ale Galoše se nevzdaly a i v oslabení sahaly po bodu."}]},"cr":[["j2007","8-a",8,12,"11","2","3","6","21:34","7"],