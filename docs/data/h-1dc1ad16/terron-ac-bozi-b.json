{"t":"Terron AC Bozi B","o":{"Kemlink 1890 FC":[{"d":"2026-05-10","l":"jaro 2026","v":"P3","h":false,"s":"2:2","hf":"2:1","r":"D","ref":"Tomáš Andrle, Jan Novák","w":"Domácím se vydařil vstup do utkání, díky dvěma povedeným střelám získali dvougólové vedení. Hosté otevřeli hru, zvýšili tlak na soupeřovu obranu a ta dvakrát povolila. Proto se soupeři rozešli smírně."}],"Vozovna Hloubětín A":[{"d":"2022-09-18","l":"podzim 2022","v":"BECH","h":false,"s":"1:5","hf":"0:3","r":"W","ref":"Černoch","w":"Vozovna se snažila, ale Bozi byli proti. Vyhráli hosté."},{"d":"2021-09-26","l":"podzim 2021","v":"P2","h":true,"s":"7:2","hf":"2:2","r":"W","ref":"Plucar","w":"Podprůměrný výkon Bohů stačil na jednoznačné utkání."},{"d":"2018-09-16","l":"podzim 2018","v":"BECH","h":false,"s":"3:7","hf":"2:3","r":"W","ref":"","w":"Zvítězilo lepší mužstvo."}],"Candy Kickers":[{"d":"2026-05-24","l":"jaro 2026","v":"P1","h":true,"s":"5:0","hf":"3:0","r":"W","ref":"Jakub Plechšmíd","w":"Terron hrál ze začátku přesilovku a vytvořil si náskok. Po té přišel soupeři opozdilec a hra se vyrovnala. Terron pak v závěru potvrdil výhru."}],"Rychlá rota":[{"d":"2026-04-12","l":"jaro 2026","v":"P1","h":true,"s":"3:4","hf":"2:3","r":"L","ref":"Jakub Plechšmíd","w":"Pěkné utkání vyhráli hosté, ale remíza by zápasu slušela více."},{"d":"2025-03-23","l":"jaro 2025","v":"P1","h":true,"s":"1:0","hf":"0:0","r":"W","ref":"Kamil Kohout","w":"Vyrovnané utkání, kterému by slušela remíza, rozhodl v poslední sekundě Šebek."},{"d":"2021-05-30","l":"podzim 2020","v":"ZABEH","h":false,"s":"4:1","hf":"1:0","r":"L","ref":"Dušan Blaha, Pavel Najman","w":"Vyrovnaný poločas, poté dominovala Rychlá rota, která byla přesnější v zakončení."},{"d":"2020-06-07","l":"jaro 2020","v":"ZABEH","h":false,"s":"0:0","hf":"","r":"D","ref":"","w":""},{"d":"2016-10-23","l":"podzim 2016","v":"P3","h":false,"s":"1:3","hf":"0:1","r":"W","ref":"","w":"Vcelku vyrovnaný zápas, ve kterém byli šťastnější hosté."}],"Inter Flamingos":[{"d":"2026-06-07",