{"t":"Yellow Dildos B","o":{"Vošach gang-bang":[{"d":"2025-11-19","l":"podzim 2025","v":"HANSP","h":true,"s":"0:1","hf":"0:1","r":"L","ref":"Michal Černoch","w":"První půle byla vyrovnaná. Po přestávce byli lepší domácí, ale vyrovnat se jim nepodařilo."},{"d":"2022-06-08","l":"jaro 2022","v":"HRAB1","h":false,"s":"5:0","hf":"3:0","r":"L","ref":"Miroslav Kotek","w":"Pěkný zápas, domácí měli více ze hry a dobrou koncovku."}],"Klub odložených mužů":[{"d":"2026-04-29","l":"jaro 2026","v":"MOTO1","h":false,"s":"0:3","hf":"0:2","r":"W","ref":"Richard Kachyňa","w":"Tvrdé, ale férové utkání, vyhrál šťastnější tým."},{"d":"2025-04-23","l":"jaro 2025","v":"MOTO1","h":false,"s":"2:0","hf":"1:0","r":"L","ref":"Jaroslav Moravský","w":"Zápas hraný ve vysoké kvalitě, vyhráli domácí."}],"Vibromax 1985":[{"d":"2018-04-25","l":"jaro 2018","v":"BIHOR","h":false,"s":"1:2","hf":"0:2","r":"W","ref":"Zdeněk Nosek, Lukáš Melichar","w":"Prvních 15 minut hosté tlačili, kombinovali a dali gól, poté se hra vyrovnala a šance byly na obou stranách. Chtěl bych vyzdvihnout bezchybný výkon domácí gólmanky. Utkání by si zasloužilo remízu. Chválím férovou hru a přístup obou mužstev."}],"Hustá pěna FC":[{"d":"2026-06-03","l":"jaro 2026","v":"HANSP","h":false,"s":"2:7","hf":"1:4","r":"W","ref":"Richard Kachyňa","w":"Hosté zvítězili zaslouženě, po celé utkání byli lepším týmem."}],"Polární záře":[{"d":"2022-11-02","l":"podzim 2022","v":"PRKOP","h":true,"s":"4:11","hf":"2:7","r":"L","ref":"Michal Neubauer","w":"Jasná výhra pro hosty."},{"d":"2019-09-19","l":"podzim 2019","v":"HANSP","h":true,"s":"9:5","hf":"4:4","r":"W","ref":"Andrle","w":"Domácí měli ze hry lepší kombinace. Dostávali se do střeleckých příležitostí, které se jim často dařilo proměnit v gól. Hosté sice zdatně sekundovali, na dva body to však tentokrát nestačilo."},{"d":"2018-10-03","l":"podzim 2018","v":"PRKOP","h":true,"s":"1:8","hf":"1:5","r":"L","ref":"Trnka","w":"Utkání dobré úrovně a jednoznačného průběhu skončilo vítězstvím týmu Pol